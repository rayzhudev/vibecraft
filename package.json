{
  "name": "vibecraft",
  "version": "0.6.0",
  "description": "RTS-style AI agent management interface",
  "main": "dist/main/index.js",
  "bin": {
    "vibecraft-mcp": "./scripts/vibecraft-mcp.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/codesign-macos-binaries.mjs && node ./scripts/rebuild-natives.mjs",
    "dev": "bun ./scripts/run-dev.mjs",
    "dev:prod-data": "VIBECRAFT_STORAGE_NAMESPACE=prod bun ./scripts/run-dev.mjs",
    "dev:tutorial": "bun ./scripts/run-dev-alias.mjs tutorial",
    "dev:onboarding": "bun ./scripts/run-dev-alias.mjs onboarding",
    "build": "vite build",
    "start": "electron dist/main/index.js",
    "build:start": "bun run build && bun run start",
    "build:mcp": "bun ./scripts/build-mcp-binary.mjs",
    "rebuild:natives": "bun ./scripts/rebuild-natives.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc --noEmit --project tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" *.md --ignore-path .prettierignore",
    "preview": "vite preview",
    "package": "bun run package:prod",
    "package:prod": "bun run build && bun run build:mcp && bun ./scripts/package-app.mjs",
    "package:prod:min": "bun run build && bun run build:mcp && bun ./scripts/package-app.mjs --config electron-builder.prod-min.json",
    "package:dev": "bun run build && bun run build:mcp && bun ./scripts/package-app.mjs --config electron-builder.dev.json",
    "test:unit": "vitest run --config vitest.main.config.ts && vitest run --config vitest.renderer.config.ts",
    "test:perf": "bunx vitest bench --config vitest.perf.config.ts --run",
    "test:perf:runtime": "bun ./scripts/run-runtime-perf.mjs",
    "perf:loop": "bun ./scripts/run-perf-loop.mjs",
    "test:e2e": "bun ./scripts/run-e2e.mjs",
    "test:e2e:integration": "bun ./scripts/run-e2e.mjs --integration",
    "test:mcp": "bun ./scripts/run-mcp-test.mjs",
    "test": "bun ./scripts/run-test-suite.mjs"
  },
  "author": "",
  "dependencies": {
    "@agentconnect/host": "0.2.9",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-log": "^5.0.0",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.2.0-beta.12",
    "posthog-js": "^1.438.14",
    "posthog-node": "^5.24.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "baseline-browser-mapping": "^2.11.30",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.12",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "browserslist": "^4.29.4",
    "fast-uri": "^3.1.9",
    "flatted": "^3.4.4",
    "form-data": "^4.0.6",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "path-to-regexp": "^8.4.2",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "tmp": "^0.2.7",
    "ws": "^8.22.0"
  }
}
